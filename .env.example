# ─── Banco de dados (PostgreSQL próprio do Contábil) ───────────
DATABASE_URL="postgresql://triage_contabil:senha@localhost:5434/triage_contabil"
DB_POOL_MAX=10

# ─── App ───────────────────────────────────────────────────────
PORT=3200
# Domínio raiz do SaaS: tenants ganham <slug>.contabil.businesstriage.com.br
ROOT_DOMAIN="contabil.businesstriage.com.br"
NEXT_PUBLIC_ROOT_DOMAIN="contabil.businesstriage.com.br"
# Tenant usado quando o host não bate com nenhum (localhost, IP etc.)
DEFAULT_TENANT_SLUG="business-triage"
# Segredo do JWT de sessão (gere com: openssl rand -base64 48)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# ─── Uploads (logotipos e favicons) ────────────────────────────
UPLOAD_DIR="./data/uploads"

# ─── E-mail (redefinição de senha) ─────────────────────────────
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="contabil@businesstriage.com.br"
SMTP_PASS=""
SMTP_FROM="Business Triage Contábil <contabil@businesstriage.com.br>"
