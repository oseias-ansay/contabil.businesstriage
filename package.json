{
  "name": "triage-contabil",
  "version": "0.1.0",
  "private": true,
  "description": "Triage Contábil — contabilidade gerencial SaaS multi-tenant / white-label da Business Triage",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p ${PORT:-3200} -H ${HOST:-127.0.0.1}",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:studio": "drizzle-kit studio",
    "test:db": "tsx tests/ledger-rules.test.ts",
    "test:reports": "tsx tests/reports.test.ts",
    "test:api": "tsx tests/api-smoke.test.ts",
    "test:parse": "tsx tests/bank-parse.test.ts",
    "test:bank": "tsx tests/bank.test.ts",
    "test": "tsx tests/bank-parse.test.ts && tsx tests/ledger-rules.test.ts && tsx tests/reports.test.ts && tsx tests/bank.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "nodemailer": "^6.9.16",
    "pdfmake": "^0.2.23",
    "pg": "^8.23.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
